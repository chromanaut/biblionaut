#!/usr/bin/env python3
"""Turns code addresses in bn-trace output into function names and source lines.

A crash report gives addresses: where the processor was, and the values on
the stack that could be return addresses. This reads text, copies it to its
output, and under every line that contains code addresses adds what each one
is:

    tools/idf build                      # also archives the firmware's ELF file
    bn-trace capture.bin | tools/bn-symbolize
    bn-trace | tools/bn-symbolize        # live, from the device
    tools/bn-symbolize 0x4200614a 0x42001514

Addresses only mean something for the exact firmware that produced them, and
one capture can hold addresses from two: a saved crash report may come from
an older build than the firmware now running and printing. So the ELF file
is chosen by build id, the start of the ELF file's SHA-256:

  - inside a crash report, by the id the report carries ("ELF 1a2b3c");
  - everywhere else (ESP-IDF's own crash dump, boot messages), by the id the
    running firmware prints when it starts and when it crashes
    ("ELF file SHA256: 1a2b3c"). Until it has printed one, the ELF file of
    the last local build is assumed.

Every firmware build puts a copy of its ELF file in .elf-archive/, named by
that hash, and this looks there. --elf uses one file for everything.

Most addresses in a crash are return addresses: where a function will carry
on after a call. The call itself is the instruction before, so that is what
gets looked up; otherwise the line shown is the one after the call, and a
call that never returns (abort) at the very end of a function shows as the
function that happens to come next in memory. Only an address labelled as a
program counter ("mepc", "PC") is looked up exactly. When the two readings
of an address land in different functions, both are shown.
"""

from __future__ import annotations

import argparse
import hashlib
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DEFAULT_ARCHIVE = ROOT / ".elf-archive"
DEFAULT_ELF = ROOT / "app" / "firmware" / "build" / "biblionaut.elf"
# ELF files kept in the archive; the oldest go first.
ARCHIVE_LIMIT = 40

ADDRESS = re.compile(r"\b0x([0-9a-fA-F]{8})\b")
# Text just before an address that marks it as a program counter: the exact
# place the processor was, not somewhere it will return to.
PROGRAM_COUNTER_LABEL = re.compile(r"(?:mepc|\bpc)\s*:?\s*$", re.IGNORECASE)
# What bn-trace prints around a crash report, and the build id inside one.
REPORT_START = "=== crash report"
REPORT_END = "=== end of crash report"
REPORT_BUILD_ID = re.compile(r"\(ELF ([0-9a-f]{6,64})\)")
# The running firmware naming itself: at start-up and at the end of
# ESP-IDF's crash dump.
RUNNING_BUILD_ID = re.compile(r"ELF file SHA256:\s*([0-9a-f]{6,64})")
# The firmware's one-line notice of a saved report. Whatever address its
# reason holds belongs to the build that crashed, which the line does not
# name; the report itself follows and is looked up properly.
SAVED_REPORT_NOTICE = "Crash report saved"

# Where an ESP32-C3 runs code from: its ROM, RAM, and flash.
CODE_RANGES = ((0x40000000, 0x40060000), (0x40380000, 0x403E0000), (0x42000000, 0x42800000))


def is_code_address(value: int) -> bool:
    return value % 2 == 0 and any(low <= value < high for low, high in CODE_RANGES)


def sha256_of(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as file:
        for block in iter(lambda: file.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def archive_elf(elf: Path, label: str, archive: Path) -> Path:
    """Copies `elf` into the archive under its hash and drops the oldest copies."""
    archive.mkdir(parents=True, exist_ok=True)
    safe_label = re.sub(r"[^A-Za-z0-9._+-]", "_", label) or "firmware"
    target = archive / f"{safe_label}-{sha256_of(elf)}.elf"
    if not target.exists():
        shutil.copyfile(elf, target)
    os.utime(target)  # Most recently built counts as newest.
    kept = sorted(archive.glob("*.elf"), key=lambda path: path.stat().st_mtime, reverse=True)
    for old in kept[ARCHIVE_LIMIT:]:
        old.unlink()
    return target


def find_in_archive(build_id: str, archive: Path) -> Path | None:
    """The archived ELF file whose hash starts with `build_id`, if there is one."""
    if not archive.is_dir():
        return None
    for path in sorted(archive.glob("*.elf")):
        file_hash = path.stem.rsplit("-", 1)[-1]
        if file_hash.startswith(build_id):
            return path
    return None


def find_addr2line(explicit: str | None) -> str | None:
    if explicit:
        return explicit
    from_environment = os.environ.get("BN_ADDR2LINE")
    if from_environment:
        return from_environment
    name = "riscv32-esp-elf-addr2line"
    local = sorted((ROOT / ".esp" / "tools" / "tools" / "riscv32-esp-elf").glob(f"**/bin/{name}"))
    if local:
        return str(local[-1])
    return shutil.which(name)


def shorten_source_path(described: str) -> str:
    """Drops the repository's own path from the front of a source file's, in addr2line's "function at file:line".

    Only there: the same text can turn up inside a longer path, and must then be left alone.
    """
    return described.replace(" at " + str(ROOT) + os.sep, " at ")


def display_path(path: Path) -> str:
    try:
        return str(path.resolve().relative_to(ROOT))
    except ValueError:
        return str(path)


class Elf:
    """An ELF file to look addresses up in, and how sure it is the right one."""

    def __init__(self, path: Path | None, confirmed: bool) -> None:
        self.path = path  # None: no file for this build; its addresses are left alone.
        self.confirmed = confirmed  # False while it is only assumed to be the build in question.
        self.used_unconfirmed = False
        self._hash: str | None = None

    def hash(self) -> str | None:
        if self.path is not None and self._hash is None:
            self._hash = sha256_of(self.path)
        return self._hash


class Symbolizer:
    def __init__(self, addr2line: str, elf: Path | None, elf_is_fixed: bool, archive: Path, out) -> None:
        self.addr2line = addr2line
        self.elf_is_fixed = elf_is_fixed  # Given with --elf: used for everything.
        self.archive = archive
        self.out = out
        self.cache: dict[tuple[Path, int], list[str]] = {}
        # The firmware that is running and printing. Until it names itself
        # this is an assumption: the last local build.
        self.running = Elf(elf, confirmed=elf_is_fixed)
        # The firmware a crash report came from, while inside that report.
        self.report: Elf | None = None
        self.warned_ids: set[str] = set()

    def note(self, text: str) -> None:
        print(f"      [bn-symbolize] {text}", file=self.out)

    def elf_for(self, build_id: str, current: Elf) -> Elf:
        """The ELF file for `build_id`: `current` if that is it, else the archived one, else none."""
        current_hash = current.hash()
        if current_hash is not None and current_hash.startswith(build_id):
            current.confirmed = True
            return current
        if self.elf_is_fixed:
            if build_id not in self.warned_ids:
                self.warned_ids.add(build_id)
                self.note(f"warning: {display_path(current.path)} is not firmware {build_id}; its answers may be wrong")
            return current
        archived = find_in_archive(build_id, self.archive)
        if archived is not None:
            self.note(f"using {display_path(archived)}")
            return Elf(archived, confirmed=True)
        self.note(
            f"no ELF file for firmware {build_id} in {display_path(self.archive)}; its addresses are left as they are"
        )
        return Elf(None, confirmed=True)

    def running_named(self, build_id: str) -> None:
        """The running firmware printed its build id."""
        before = self.running
        self.running = self.elf_for(build_id, before)
        if self.running is not before and before.used_unconfirmed:
            self.note(
                f"warning: addresses above, outside crash reports, were looked up in {display_path(before.path)}, "
                "which is not this firmware"
            )

    def resolve(self, elf: Path, addresses: list[int]) -> None:
        """Fills the cache with what addr2line says about each address."""
        missing = [address for address in dict.fromkeys(addresses) if (elf, address) not in self.cache]
        if not missing:
            return
        result = subprocess.run(
            [self.addr2line, "-pfiaC", "-e", str(elf), *[f"0x{address:08x}" for address in missing]],
            capture_output=True,
            text=True,
            check=False,
        )
        # One line per address, "0x...: function at file:line", then
        # "(inlined by)" lines for the functions it was inlined into.
        current: int | None = None
        for line in result.stdout.splitlines():
            match = re.match(r"0x([0-9a-fA-F]+): (.*)", line)
            if match:
                current = int(match.group(1), 16)
                text = match.group(2).rstrip()
                unknown = text in ("?? ??:0", "?? at ??:0")
                self.cache[(elf, current)] = [] if unknown else [shorten_source_path(text)]
            elif current is not None and self.cache[(elf, current)]:
                self.cache[(elf, current)].append(shorten_source_path(line))
        for address in missing:
            self.cache.setdefault((elf, address), [])

    @staticmethod
    def outer_function(described: list[str]) -> str:
        """The function an address is really in: the last one it was inlined into."""
        text = described[-1].strip()
        if text.startswith("(inlined by) "):
            text = text[len("(inlined by) ") :]
        return text.rsplit(" at ", 1)[0]

    def lookup(self, elf: Elf, addresses: list[tuple[int, bool]]) -> list[str]:
        """Lines describing each address the ELF file knows. Each is (address, is a program counter)."""
        if elf.path is None or not addresses:
            return []
        wanted: list[int] = []
        for address, exact in addresses:
            wanted.extend([address] if exact else [address - 1, address])
        self.resolve(elf.path, wanted)

        lines: list[str] = []
        for address, exact in addresses:
            here = self.cache[(elf.path, address)]
            before = [] if exact else self.cache[(elf.path, address - 1)]
            label = f"0x{address:08x}: "
            if not before:
                # A program counter, or nothing is known about the instruction before.
                if here:
                    lines.append(label + here[0])
                    lines.extend(here[1:])
                continue
            lines.append(label + before[0])
            lines.extend(before[1:])
            if here and self.outer_function(here) != self.outer_function(before):
                # The address is the first of a function: either that function's
                # address, or the return address of a call that ended the one before.
                lines.append(f" (or, if not a return address, the start of {self.outer_function(here)})")
        if lines and not elf.confirmed:
            elf.used_unconfirmed = True
        return lines

    def process(self, line: str) -> None:
        print(line, file=self.out)

        if REPORT_END in line:
            self.report = None
        elif REPORT_START in line:
            # Until the report names its build, assume the running firmware.
            self.report = self.running
        report_build = REPORT_BUILD_ID.search(line)
        if report_build:
            self.report = self.elf_for(report_build.group(1), self.report or self.running)

        addresses: list[tuple[int, bool]] = []
        if SAVED_REPORT_NOTICE not in line:
            for match in ADDRESS.finditer(line):
                value = int(match.group(1), 16)
                if is_code_address(value) and all(value != seen for seen, _ in addresses):
                    exact = PROGRAM_COUNTER_LABEL.search(line[: match.start()]) is not None
                    addresses.append((value, exact))
        for described in self.lookup(self.report or self.running, addresses):
            print(f"      {described}", file=self.out)

        # ESP-IDF names the build after the addresses it is about, so this
        # comes last: it confirms or corrects what was used above.
        running_build = RUNNING_BUILD_ID.search(line)
        if running_build and self.report is None:
            self.running_named(running_build.group(1))
        self.out.flush()


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Turns code addresses in bn-trace output into function names and source lines.",
        epilog="With no ADDRESS, reads text on standard input and writes it, annotated, to standard output.",
    )
    parser.add_argument(
        "addresses",
        nargs="*",
        metavar="ADDRESS",
        help="addresses to look up exactly, such as 0x4200614a; for a return address, give the address less one",
    )
    parser.add_argument("--elf", type=Path, help="the ELF file to look addresses up in, whatever build the text names")
    parser.add_argument(
        "--assume-elf",
        type=Path,
        default=DEFAULT_ELF,
        help="the ELF file of the running firmware until it names itself (default: the last local build)",
    )
    parser.add_argument("--archive-dir", type=Path, default=DEFAULT_ARCHIVE, help="where archived ELF files are kept")
    parser.add_argument("--addr2line", help="the addr2line program to use (default: the one ESP-IDF installed)")
    parser.add_argument("--archive", type=Path, metavar="ELF", help="add ELF to the archive and exit (used by the build)")
    parser.add_argument("--label", default="firmware", help="with --archive: the firmware's version, for the file name")
    arguments = parser.parse_args()

    if arguments.archive is not None:
        if not arguments.archive.is_file():
            print(f"error: {arguments.archive} does not exist", file=sys.stderr)
            return 1
        target = archive_elf(arguments.archive, arguments.label, arguments.archive_dir)
        print(f"Archived the ELF file as {display_path(target)}")
        return 0

    addr2line = find_addr2line(arguments.addr2line)
    if addr2line is None:
        print("error: riscv32-esp-elf-addr2line not found. Run tools/setup-idf.sh, or pass --addr2line.", file=sys.stderr)
        return 1

    assumed = arguments.assume_elf if arguments.assume_elf.is_file() else None
    elf = arguments.elf if arguments.elf is not None else assumed
    if arguments.elf is not None and not arguments.elf.is_file():
        print(f"error: {arguments.elf} does not exist", file=sys.stderr)
        return 1
    symbolizer = Symbolizer(addr2line, elf, arguments.elf is not None, arguments.archive_dir, sys.stdout)

    if arguments.addresses:
        if elf is None:
            print("error: no ELF file: build the firmware (tools/idf build) or pass --elf", file=sys.stderr)
            return 1
        failed = False
        for text in arguments.addresses:
            try:
                value = int(text, 16)
            except ValueError:
                print(f"error: '{text}' is not a hexadecimal address", file=sys.stderr)
                failed = True
                continue
            described = symbolizer.lookup(symbolizer.running, [(value, True)])
            for line in described or [f"0x{value:08x}: not in {display_path(elf)}"]:
                print(line)
        return 1 if failed else 0

    try:
        for line in sys.stdin:
            symbolizer.process(line.rstrip("\n"))
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
