# Pieces of CSS that the reader looks for: given to the fuzzing engine
# (tools/fuzz.py) for the target that reads CSS, which would be a long time
# coming to them by changing bytes. One piece a line, in quotes.

# The marks
"/*"
"*/"
"!important"
"::first-letter"
":link"
":hover"
"::before"
" > "
" + "
" ~ "
"[epub|type~=\"x\"]"
"[hidden]"
"[*|"
"~="
"|="
"^="
"$="
"*="
" i]"
"='"
"\\31 "
"\\0"
"<!--"
"-->"
"\xef\xbb\xbf"

# At-rules
"@media "
"@import "
"@font-face"
"@page"
"@charset"
"@supports"
"not amzn-mobi"
"amzn-kf8"
"screen"
"print"
"only "
" and ("
"url("

