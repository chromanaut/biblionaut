CONFIG_IDF_TARGET="esp32c3"

# Supported devices have 16 MB of flash.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Console over the chip's built-in USB Serial/JTAG port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Compiled for speed (-O2). ESP-IDF's own default is its level for
# debugging (-Og), which is what a firmware gets if this line is lost, and
# no timing taken on a device means much at that level. Measured on an X4
# reading 34 books: at -O2 the inflater is half as fast again as at -Og and
# XML is parsed a seventh faster, for 22 KB more flash; at -Os, for size,
# both are hardly faster than at -Og, and a test pattern takes nearly twice
# as long to draw.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# ESP-IDF's assertions stay on, with their messages. One that fails ends in
# the panic handler, and so in a crash report that says where. This is the
# default; stated so a change in defaults cannot go unnoticed.
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y

# C++ without exceptions or RTTI. These are the ESP-IDF
# defaults; stated so a change in defaults cannot go unnoticed.
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# Some of ESP-IDF's own code in flash and not in RAM. On this chip code
# runs from either, and RAM that holds code is RAM the heap does not have.
# ESP-IDF keeps a good deal of itself in RAM so that it can run while the
# chip's flash is being written, when nothing can be read from flash. This
# firmware writes its flash nowhere; and if it did, code left in flash
# would only wait for the write to end, since ESP-IDF holds off every
# interrupt whose handler is there. These three give the heap 13 KB more.
# On an X4, reading 34 books took what it took before (108.5 s against
# 108.6 s), as did the card's own check and writing to the panel; getting
# a picture out of the cache and ready to show took 2% longer (207 ms
# against 204 ms).
#   The driver for the chip's flash that is in the chip's ROM, in place of
#   ESP-IDF's. It is used at start, and to map flash into the processor's
#   address space, which is how fonts are to be read: what is mapped is
#   read as fast as it was (docs/fonts.md, "A partition for fonts").
CONFIG_SPI_FLASH_ROM_IMPL=y
#   The ring buffer's functions for interrupt handlers, which the USB
#   port's driver calls.
CONFIG_RINGBUF_PLACE_ISR_FUNCTIONS_INTO_FLASH=y
#   The C library's locks.
CONFIG_LIBC_LOCKS_PLACE_IN_IRAM=n
# Left as it is: the heap's own functions (CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH).
# In flash they would give 17 KB more, but ESP-IDF then moves the SPI
# driver's interrupt handler there too, which the card's driver uses for
# every block of data: on an X4 the card read 6% slower, and the 34 books
# took 4% longer.

# The SD card's file system (hw/esp32c3/sd_storage.cpp).
#   One card. File names as long as a card allows, in UTF-8.
CONFIG_FATFS_VOLUME_COUNT=1
CONFIG_FATFS_LFN_STACK=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
#   As many files open at once as the storage layer allows. This also has
#   FatFS refuse to remove or rename a file that is open.
CONFIG_FATFS_FS_LOCK=8
#   One sector buffer for the card, not one more for each open file: files
#   are read and written a block at a time, which does not go through it.
CONFIG_FATFS_PER_FILE_CACHE=n
#   That buffer inside FatFS's own record of the card, not taken from the
#   heap. (ESP-IDF 6.0.1 also fails to compile FatFS with heap buffers and
#   no per-file cache.) Its size is the largest sector of anything FatFS
#   might be used on, which unless told otherwise is 4096 bytes for the
#   chip's own flash; a card's sectors are 512.
CONFIG_FATFS_USE_DYN_BUFFERS=n
CONFIG_WL_SECTOR_SIZE_512=y
# FatFS is built able to keep a map of where a file's pieces are on the
# card, so that going to a place in the file needs no reading of the card.
# It keeps one only for a file it is given a table for, which the card's
# driver does for a large file opened to be read (hw/esp32c3/sd_storage.cpp).
CONFIG_FATFS_USE_FASTSEEK=y

# The watchdog. The task the application's loop runs on is watched
# (app_main.cpp subscribes it and reports once a turn of the loop), and so
# is the idle task, which only runs if nothing else keeps the processor. If
# either goes this many seconds without reporting, the firmware stops in
# the panic handler, which leaves a crash report saying where it was, and
# restarts. ESP-IDF's default is to print a warning and carry on, which a
# device with nobody watching its console cannot use. Five seconds is far
# longer than any turn of the loop should take (a turn works for about
# 20 ms), and longer than the longest wait a turn can make, which is two
# seconds for a panel that does not answer.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y

# Stack for the task the application runs on. FatFS keeps a long file name
# on the stack while it works on one, which the default (3584) has no room
# for.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
