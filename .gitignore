# Host builds (cmake --preset ...)
/build/

# ESP-IDF and its tools, installed by tools/setup-idf.sh
/.esp/

# ESP-IDF build output and generated configuration
/app/firmware/build/
/app/firmware/sdkconfig
/app/firmware/sdkconfig.old
/app/firmware/managed_components/

# Copies of each firmware build's ELF file, for symbolizing crash reports
/.elf-archive/

# Captures of the diagnostic stream (bn-trace | tee books.log). One from a
# device can name the books on its card.
*.log

# Editors and OS
/.cache/
.DS_Store
.idea/
.vscode/
compile_commands.json
