# Pieces of XML that the readers of a book look for: given to the fuzzing
# engine (tools/fuzz.py) for the targets that read XML, which would be a
# long time coming to them by changing bytes. One piece a line, in quotes.

# XML itself
"<?xml version=\"1.0\"?>"
"encoding=\"UTF-16\""
"encoding=\"ISO-8859-1\""
"<!DOCTYPE "
" PUBLIC \"x\" \"y\""
"<!ENTITY "
"<!ATTLIST "
"<![CDATA["
"]]>"
"<!--"
"-->"
"<?"
"?>"
"/>"
"</"
"&amp;"
"&nbsp;"
"&#x"
"xmlns:"
"\xef\xbb\xbf"
"\xff\xfe"

# The container and the package
"<rootfile "
"full-path=\""
"<package"
"<metadata"
"<dc:title>"
"<dc:creator>"
"<dc:language>"
"<meta name=\"cover\" content=\""
"<manifest>"
"<item "
"id=\""
"href=\""
"media-type=\""
"application/xhtml+xml"
"application/x-dtbncx+xml"
"image/jpeg"
"properties=\"nav\""
"properties=\"cover-image\""
"<spine"
"toc=\""
"<itemref "
"idref=\""
"linear=\"no\""
"OEBPS/"
"ch1.xhtml"
"text/ch2.xhtml"
"ch%203.xhtml"
"notes.xhtml"
"../"
"%2E"

# The tables of contents
"<navMap>"
"<navPoint"
"<navLabel>"
"<text>"
"<content src=\""
"<pageList>"
"<nav "
"epub:type=\"toc\""
"epub:type=\"landmarks\""
"<ol>"
"</ol>"
"<li>"
"</li>"
"<a href=\""
"</a>"
"<span>"
"#"
