{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host",
      "displayName": "Host, debug, sanitizers on",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BN_SANITIZE": "ON"
      }
    },
    {
      "name": "host-release",
      "displayName": "Host, optimised, no sanitizers",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BN_SANITIZE": "OFF"
      }
    },
    {
      "name": "window",
      "displayName": "Host, debug, sanitizers on, with the desktop application's window (fetches and builds SDL)",
      "inherits": "host",
      "binaryDir": "${sourceDir}/build/window",
      "cacheVariables": {
        "BN_DESKTOP_WINDOW": "ON"
      }
    },
    {
      "name": "tidy",
      "displayName": "Host, clang-tidy on every source",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/tidy",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BN_SANITIZE": "OFF",
        "BN_CLANG_TIDY": "ON",
        "BN_DESKTOP_WINDOW": "ON"
      }
    },
    {
      "name": "fuzz",
      "displayName": "Fuzz targets with the fuzzing engine and sanitizers (needs LLVM's clang: tools/fuzz.py)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/fuzz",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BN_SANITIZE": "ON",
        "BN_FUZZ": "ON"
      }
    },
    {
      "name": "fuzz-noasan",
      "displayName": "Fuzz targets with the fuzzing engine, without AddressSanitizer (needs LLVM's clang: tools/fuzz.py)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/fuzz-noasan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "BN_SANITIZE": "OFF",
        "BN_FUZZ": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host",
      "configurePreset": "host"
    },
    {
      "name": "host-release",
      "configurePreset": "host-release"
    },
    {
      "name": "window",
      "configurePreset": "window",
      "targets": ["biblionaut-desktop"]
    },
    {
      "name": "tidy",
      "configurePreset": "tidy"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "targets": ["fuzz_targets"]
    },
    {
      "name": "fuzz-noasan",
      "configurePreset": "fuzz-noasan",
      "targets": ["fuzz_targets"]
    }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-release",
      "configurePreset": "host-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "window",
      "configurePreset": "window",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "^e2e\\.Window$"
        }
      }
    }
  ]
}
