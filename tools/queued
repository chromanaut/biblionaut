#!/usr/bin/env python3
"""Runs a command when its turn comes.

Some of the checks here take every processor for minutes: CI's Linux jobs
in Docker, the fuzz targets, clang-tidy. Two of them started at once, from
two checkouts of the repository, each take twice as long, and five make the
machine useless for anything else. This makes them take turns:

    tools/queued COMMAND [ARGUMENT...]

waits until no other command started this way is running, then runs
COMMAND. Those that wait are served in the order they came. The heavy
checks call it for themselves (tools/linux-check.sh, tools/fuzz.py,
tools/check-tidy.sh, tools/check-firmware-tidy.py), so there is usually
nothing to type; and a command started by one that is having its turn
does not wait for a turn of its own.

    tools/queued --name NAME COMMAND...   a queue of its own: what is in
                                          one does not wait for another.
                                          Without it the name is "heavy".
    tools/queued --list                   what is running and what waits
    tools/queued --watch                  the same, kept up to date until
                                          it is stopped with Ctrl-C

A device with one cable is such a thing too. A run on it, flashing and
capturing together as one command, can take its turn in a queue named
for the device:

    tools/queued --name x4 sh -c 'tools/idf flash && bn-trace --seconds 60 > run.log'

How it works. A turn is a lock on a file, taken with flock(2), in a
folder every checkout on the machine shares: ~/.cache/biblionaut/queue,
or $XDG_CACHE_HOME/biblionaut/queue, or $BN_QUEUE_DIR. The command is not
run as a child: this program becomes it, so the lock is the command's
own, it ends when the command and whatever it started have ended, however
they end, and nothing is left to clear up after one that was killed.
Whoever waits keeps a file of its own in a folder beside the lock, named
for when it came and locked in the same way, so that the others can tell
both the order and whether its owner is still there.

With BN_QUEUE_OFF set to anything, or if the folder cannot be used, the
command is run at once.

--watch draws each queue again twice a second: what has the turn and for
how long, and each that waits, with the checkout's folder and the command,
a long path in it cut to its last name. Written to a file or a pipe and
not a terminal, it says the same once each time something changes.
"""

from __future__ import annotations

import datetime
import errno
import fcntl
import os
import re
import shlex
import shutil
import sys
import time
from pathlib import Path

HELD = "BN_QUEUE_HELD"  # The queues a command's ancestors are having their turn in.
POLL_SECONDS = 0.5
LOOK_AGAIN_SECONDS = 0.05


def queue_folder() -> Path:
    named = os.environ.get("BN_QUEUE_DIR")
    if named:
        return Path(named)
    cache = os.environ.get("XDG_CACHE_HOME")
    return (Path(cache) if cache else Path.home() / ".cache") / "biblionaut" / "queue"


def try_lock(descriptor: int) -> bool:
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return True
    except OSError as error:
        if error.errno in (errno.EWOULDBLOCK, errno.EAGAIN):
            return False
        raise


def from_home(where: str) -> str:
    """A folder as it is written from the home folder, if it is in it."""
    home = str(Path.home())
    if where == home or where.startswith(home + os.sep):
        return "~" + where[len(home) :]
    return where


def describe(command: list[str]) -> str:
    """One line saying what a command is, where, and since when."""
    now = datetime.datetime.now().strftime("%H:%M:%S")
    return f"{shlex.join(command)}, in {from_home(os.getcwd())}, since {now}, process {os.getpid()}"


def read_line(path: Path) -> str:
    try:
        return path.read_text(errors="replace").strip()
    except OSError:
        return ""


def waiting(folder: Path, name: str) -> list[Path]:
    """The files of those waiting in a queue whose owners are still there,
    in the order they came. A file whose owner has gone is removed."""
    alive = []
    try:
        tickets = sorted(path for path in (folder / f"{name}.waiting").iterdir() if not path.name.startswith("."))
    except OSError:
        return alive
    for ticket in tickets:
        try:
            descriptor = os.open(ticket, os.O_RDWR)
        except OSError:
            continue  # Its owner's turn came, between the listing and now.
        try:
            if try_lock(descriptor):
                # Nobody holds it: whoever made it was killed while waiting.
                try:
                    ticket.unlink()
                except OSError:
                    pass
            else:
                alive.append(ticket)
        finally:
            os.close(descriptor)
    return alive


def duration(seconds: float) -> str:
    whole = max(int(seconds), 0)
    if whole < 60:
        return f"{whole} s"
    if whole < 3600:
        return f"{whole // 60} min {whole % 60} s"
    return f"{whole // 3600} h {whole % 3600 // 60} min"


def take_turn(folder: Path, name: str, command: list[str]) -> int:
    """Waits for a turn in the queue `name` and returns the descriptor of
    its lock, which is the turn: whoever holds it open has it."""
    line = describe(command)
    folder.mkdir(parents=True, exist_ok=True)
    lock = os.open(folder / f"{name}.lock", os.O_RDWR | os.O_CREAT, 0o600)

    # A place in the queue. The file is locked before it has the name the
    # others look for, so that none of them can find it unlocked and take
    # its owner for gone.
    tickets = folder / f"{name}.waiting"
    tickets.mkdir(exist_ok=True)
    unnamed = tickets / f".new-{os.getpid()}"
    ticket_descriptor = os.open(unnamed, os.O_RDWR | os.O_CREAT | os.O_TRUNC, 0o600)
    fcntl.flock(ticket_descriptor, fcntl.LOCK_EX)
    os.write(ticket_descriptor, (line + "\n").encode())
    ticket = tickets / f"{time.time_ns():020d}-{os.getpid()}"
    unnamed.rename(ticket)

    began = time.monotonic()
    said = None
    try:
        while True:
            ahead = [other for other in waiting(folder, name) if other.name < ticket.name]
            free = try_lock(lock)
            if not free and said is None:
                # --list and --watch take the lock for a moment to see
                # whether anything has it. Look once more before saying that
                # something is running.
                time.sleep(LOOK_AGAIN_SECONDS)
                free = try_lock(lock)
            if free and not ahead:
                break
            if free:
                # Free, but it is another's turn: let go, for that one to take.
                fcntl.flock(lock, fcntl.LOCK_UN)
                running = ""
            else:
                running = " Running now: " + (read_line(folder / f"{name}.lock") or "something that has not said what it is") + "."
            others = f" {len(ahead)} waiting before this." if ahead else ""
            saying = f"queued: waiting for a turn ({name}).{running}{others}"
            if saying != said:
                print(saying, file=sys.stderr, flush=True)
                said = saying
            time.sleep(POLL_SECONDS)
    finally:
        try:
            ticket.unlink()
        except OSError:
            pass
        os.close(ticket_descriptor)

    # What is running, for the others to say: with the time its turn began,
    # where the line in the queue had the time it came.
    os.ftruncate(lock, 0)
    os.pwrite(lock, (describe(command) + "\n").encode(), 0)
    if said is not None:
        print(f"queued: its turn came after {duration(time.monotonic() - began)}.", file=sys.stderr, flush=True)
    return lock


def queues(folder: Path) -> list[str]:
    """The names of the queues there have been, in order."""
    names = set()
    try:
        for path in folder.iterdir():
            if path.name.endswith(".lock"):
                names.add(path.name[: -len(".lock")])
            elif path.name.endswith(".waiting"):
                names.add(path.name[: -len(".waiting")])
    except OSError:
        pass
    return sorted(names)


def running(folder: Path, name: str) -> str | None:
    """What has the turn in a queue, as it described itself: nothing, if
    nothing has, and no words if it has not said."""
    try:
        descriptor = os.open(folder / f"{name}.lock", os.O_RDWR)
    except OSError:
        return None
    try:
        if try_lock(descriptor):
            return None
    finally:
        os.close(descriptor)  # And with it the lock, if it was taken to look.
    return read_line(folder / f"{name}.lock")


def owner_has_ended(line: str) -> bool:
    """Whether the process a line names is gone, while its turn goes on."""
    owner = line.rsplit("process ", 1)[-1] if "process " in line else ""
    return owner.isdigit() and not process_exists(int(owner))


def show(folder: Path) -> int:
    names = queues(folder)
    if not names:
        print(f"Nothing has been queued in {folder}.")
        return 0
    for name in names:
        line = running(folder, name)
        if line is None:
            print(f"{name}: nothing running.")
        else:
            print(f"{name}: running: {line or 'something that has not said what it is'}.")
            if owner_has_ended(line):
                print(f"{name}:   that process has ended, and something it started still has the turn.")
        for ticket in waiting(folder, name):
            print(f"{name}: waiting: {read_line(ticket)}.")
    return 0


# A path of three folders or more, up to its last name.
LONG_PATH = re.compile(r"[~/]?(?:[\w.@+-]+/){3,}(?=[\w.@+-])")


def taken_apart(line: str) -> tuple[str, str]:
    """A line of describe() as the command and the last name of where it
    was started. A line that is not one is all command."""
    rest, since, _ = line.rpartition(", since ")
    command, within, where = rest.rpartition(", in ")
    if not since or not within:
        return line, ""
    return command, where.rstrip("/").rsplit("/", 1)[-1]


def began(path: Path) -> float | None:
    """When a turn began, or a wait: the lock is written as a turn begins,
    and a waiting file is named for when it came."""
    try:
        stamp = path.name.split("-", 1)[0]
        return int(stamp) / 1e9 if stamp.isdigit() else path.stat().st_mtime
    except OSError:
        return None


def picture(folder: Path) -> list[tuple[str, str, float | None, str, str]]:
    """A row for everything in every queue: the queue, what it is doing,
    since when, where it was started, and the command."""
    rows: list[tuple[str, str, float | None, str, str]] = []
    for name in queues(folder):
        line = running(folder, name)
        if line is None:
            rows.append((name, "nothing running", None, "", ""))
        else:
            command, where = taken_apart(line or "something that has not said what it is")
            rows.append((name, "running", began(folder / f"{name}.lock"), where, command))
            if owner_has_ended(line):
                rows.append((name, "", None, "", "that process has ended, and something it started still has the turn"))
        for ticket in waiting(folder, name):
            command, where = taken_apart(read_line(ticket))
            rows.append((name, "waiting", began(ticket), where, command))
    return rows


def drawn(rows: list[tuple[str, str, float | None, str, str]], now: float, width: int | None) -> list[str]:
    """The rows as lines of text in columns, a queue's name on the first of
    its rows only, each line cut to `width` if there is one."""
    times = [duration(now - since) if since is not None else "" for _, _, since, _, _ in rows]
    names = max((len(row[0]) for row in rows), default=0)
    clocks = max((len(text) for text in times), default=0)
    places = max((len(row[3]) for row in rows), default=0)
    lines = []
    before = None
    for (name, doing, _, where, command), clock in zip(rows, times):
        shown = name if name != before else ""
        before = name
        if doing == "nothing running":
            line = f"{shown:<{names}}  {doing}"
        else:
            line = f"{shown:<{names}}  {doing:<7}  {clock:>{clocks}}  {where:<{places}}  {LONG_PATH.sub('.../', command)}"
        line = line.rstrip()
        if width is not None and len(line) > width:
            line = line[: max(width - 3, 0)] + "..."
        lines.append(line)
    return lines


def watch(folder: Path) -> int:
    """Says what is in the queues until it is stopped: on a terminal by
    drawing them again and again in one place, and otherwise once each time
    something other than a time changes."""
    terminal = sys.stdout.isatty()
    last = None
    try:
        if terminal:
            sys.stdout.write("\x1b[2J")
        while True:
            rows = picture(folder)
            now = time.time()
            clock = datetime.datetime.now().strftime("%H:%M:%S")
            nothing = [f"Nothing has been queued in {folder}."] if not rows else []
            if terminal:
                width = shutil.get_terminal_size((100, 24)).columns
                top = f"{clock}  the queues in {from_home(str(folder))}  (Ctrl-C to stop)"
                lines = [top[:width], "", *nothing, *drawn(rows, now, width)]
                sys.stdout.write("\x1b[H" + "".join(line + "\x1b[K\n" for line in lines) + "\x1b[J")
                sys.stdout.flush()
            else:
                still = [(name, doing, where, command) for name, doing, _, where, command in rows]
                if still != last:
                    print("\n".join([clock, *nothing, *drawn(rows, now, None), ""]), flush=True)
                    last = still
            time.sleep(POLL_SECONDS)
    except KeyboardInterrupt:
        return 0
    except BrokenPipeError:
        # Whoever was reading has gone. Nothing more is written, at the end either.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        return 0


def process_exists(process: int) -> bool:
    try:
        os.kill(process, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def become(command: list[str]) -> int:
    try:
        os.execvp(command[0], command)
    except OSError as error:
        print(f"queued: {command[0]}: {error.strerror}", file=sys.stderr)
        return 127 if error.errno == errno.ENOENT else 126


def main(arguments: list[str]) -> int:
    name = "heavy"
    while arguments and arguments[0].startswith("-"):
        option = arguments.pop(0)
        if option == "--":
            break
        if option in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        if option == "--list":
            return show(queue_folder())
        if option == "--watch":
            return watch(queue_folder())
        if option == "--name" and arguments:
            name = arguments.pop(0)
            if not name or not all(letter.isalnum() or letter in "-_" for letter in name):
                print("queued: a queue's name is letters, digits, - and _", file=sys.stderr)
                return 2
            continue
        print(f"queued: unknown option {option}; --help says what there is", file=sys.stderr)
        return 2
    if not arguments:
        print(
            "usage: tools/queued [--name NAME] COMMAND [ARGUMENT...]\n       tools/queued --list\n       tools/queued --watch",
            file=sys.stderr,
        )
        return 2

    held = os.environ.get(HELD, "").split(":")
    if name in held:
        return become(arguments)
    # What the command starts is told not to wait for a turn in this queue:
    # it is having one. That is said even where no turn is taken, so that a
    # script which calls this for itself can tell that it has been through.
    os.environ[HELD] = ":".join(part for part in [*held, name] if part)
    if os.environ.get("BN_QUEUE_OFF"):
        return become(arguments)
    try:
        lock = take_turn(queue_folder(), name, arguments)
    except OSError as error:
        print(f"queued: {queue_folder()}: {error.strerror}. Running without waiting for a turn.", file=sys.stderr)
        return become(arguments)
    os.set_inheritable(lock, True)  # The command inherits the lock.
    return become(arguments)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
